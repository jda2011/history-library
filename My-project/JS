// 로그인 후 메인 화면 진입 시 실행되는 함수
async function applySiteBackground() {
  try {
    const res = await fetch('/api/config');
    const config = await res.json();

    const body = document.body;

    // 관리자가 등록한 배경 이미지가 있으면 이미지 적용, 없으면 배경색 적용
    if (config.backgroundImageUrl) {
      body.style.backgroundImage = `url('${config.backgroundImageUrl}')`;
      body.style.backgroundSize = 'cover';
      body.style.backgroundPosition = 'center';
    } else if (config.backgroundColor) {
      body.style.backgroundColor = config.backgroundColor;
    }
  } catch (err) {
    console.error('배경 설정을 불러오지 못했습니다.', err);
  }
}

// 페이지 로드 시 실행
document.addEventListener('DOMContentLoaded', applySiteBackground);
